{
  "name": "@web-locks/core",
  "version": "0.1.0-beta.1",
  "description": "Framework-agnostic helpers for the Web Locks API.",
  "keywords": [
    "locks",
    "mutex",
    "navigator.locks",
    "web-locks"
  ],
  "homepage": "https://github.com/web-locks/web-locks#readme",
  "bugs": {
    "url": "https://github.com/web-locks/web-locks/issues"
  },
  "license": "Apache-2.0",
  "author": "Tim McQueen <tim.mcqueen@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-locks/web-locks.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepack": "cp ../../LICENSE ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@web-locks/fake-locks": "workspace:*",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
